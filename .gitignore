# ==============================
# VisaTrack - Git Ignore Rules
# ==============================

# Private notes and session logs
SESSION-LOG.md
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDEs and editors
.vscode/
.idea/

# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/
dist/
.turbo/
next-env.d.ts

# Test coverage
coverage/

# Local databases and database files
*.db
*.sqlite
*.sqlite3
*.pglite

# Environment variables and secrets
.env*
!.env.example

# Local application data (if created inside the project)
pglite/

# OS-generated files
.DS_Store
Thumbs.db