# Copier en .env.local
# Si fourni : la base est ce Postgres (Supabase). Sinon : base locale PGLite (.data/pglite).
DATABASE_URL=

# Données locales PGLite (défaut .data/pglite, à placer hors OneDrive sous Windows)
# PGLITE_DATA_DIR=.data/pglite

# Email — fournisseur : smtp ou resend (vide = smtp si configuré, sinon resend)
EMAIL_PROVIDER=

# Email — Gmail SMTP (recommandé sans domaine : mot de passe d'application Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VisaTrack TN <votre-adresse@gmail.com>"

# Alternative Resend (uniquement avec un domaine vérifié)
# RESEND_API_KEY=
# EMAIL_FROM="VisaTrack TN <no-reply@votre-domaine.tn>"

# Google OAuth (bouton « Continuer avec Google » affiché seulement si configuré)
# Console Google Cloud → APIs & Services → Credentials → OAuth client ID (Web)
# URI de redirection autorisée : https://votre-domaine.tn/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL publique de l'application (recommandé en production derrière un proxy)
# NEXT_PUBLIC_APP_URL=https://votre-domaine.tn

# Clé de chiffrement des emails stockés — stable et secrète.
# Générer une fois : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_CRYPT_KEY=

# Administrateurs initiaux (séparés par des virgules). Ils deviennent admin à leur première connexion.
ADMIN_EMAILS=

# 1 = injecter les données de démonstration (JAMAIS en production). 0 = base vide.
SEED_DEMO=0
